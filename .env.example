# Server-only canonical URL. Next.js loads .env.local automatically.
# Use your public production URL when deploying.
APP_URL=http://bacurim.mamura.test

# NEXT_PUBLIC_* values are public and embedded at build time.
# Never use this prefix for tokens, passwords or other credentials.

# Enable the technical preview only when explicitly testing a production build.
# Development serves /dev/ui regardless of this flag.
ENABLE_UI_PREVIEW=false

# Isolated architecture example; never enable in normal production.
ENABLE_ARCHITECTURE_PREVIEW=false
